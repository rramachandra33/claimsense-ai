# Copy to .env and fill in. Never commit .env.
# Local database from `make up` (host port 5433).
CLAIMSENSE_DB_URL=postgresql://claimsense:claimsense@localhost:5433/claimsense
# Secret for signing DEVELOPMENT tokens only. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
CLAIMSENSE_JWT_SECRET=<generate-a-long-random-value>
